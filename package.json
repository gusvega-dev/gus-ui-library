{
  "name": "@gusvega-dev/gus-ui-library",
  "version": "0.1.1",
  "description": "React UI component library built on Tailwind CSS",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:js": "tsup",
    "build:css": "postcss src/styles/index.css -o dist/style.css",
    "build": "npm run build:js && npm run build:css",
    "dev:js": "tsup --watch",
    "dev:css": "onchange 'src/styles/**/*' '../gus-ui-tokens/dist/*.js' --initial -- postcss src/styles/index.css -o dist/style.css",
    "dev": "npm run dev:js & npm run dev:css",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@gusvega-dev/gus-ui-tokens": "file:../gus-ui-tokens",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "onchange": "^7.1.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.2"
  }
}
