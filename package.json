{
  "name": "@gusvega/ui",
  "version": "0.5.0",
  "description": "React UI component library built on Tailwind CSS",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "sideEffects": [
    "./dist/style.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:js": "tsup",
    "build:css": "postcss src/styles/index.css -o dist/style.css",
    "build": "npm run build:js && npm run build:css",
    "dev:js": "tsup --watch",
    "dev:css": "onchange 'src/**/*.{ts,tsx,css}' --initial -- postcss src/styles/index.css -o dist/style.css",
    "dev": "npm run dev:js & npm run dev:css",
    "release": "changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "recharts": ">=2.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.18",
    "jsdom": "^27.0.1",
    "onchange": "^7.1.0",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.2",
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    }
  }
}
